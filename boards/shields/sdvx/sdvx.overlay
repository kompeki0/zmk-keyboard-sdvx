#include <zephyr/dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>

&uicr {
    nfct-pins-as-gpios;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";
        status = "okay";
        wakeup-source;
        input-gpios
            = <&xiao_d 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>
            , <&xiao_d 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>
            , <&xiao_d 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>
            , <&xiao_d 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>
            , <&xiao_d 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>
            , <&xiao_d 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>
            , <&xiao_d 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>
            ;
    };

    default_transform: matrix_transform0 {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <7>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>;
        transform = <&default_transform>;
    };

    keymap_sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&ec11_right &ec11_left>;
    };
};

/ {
    ec11_right: ec11_right {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 10 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        b-gpios = <&xiao_d 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        status = "okay";
    };

    ec11_left: ec11_left {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        b-gpios = <&xiao_d 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        status = "okay";
    };
};
