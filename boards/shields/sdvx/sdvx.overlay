#include <zephyr/dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios
            = <&gpio0 28 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)> /* D2 */
            , <&gpio0 29 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)> /* D3 */
            , <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>  /* D4 */
            , <&gpio0 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>  /* D5 */
            , <&gpio1 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)> /* D6 */
            , <&gpio1 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)> /* D7 */
            , <&gpio1 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)> /* D8 */
            ;
    };

    default_transform: matrix_transform0 {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <7>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)
        >;
    };

    keymap_sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&ec11_right &ec11_left>;
    };
};

/ {
    ec11_right: ec11_right {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;  /* D0 */
        b-gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;  /* D1 */
        status = "okay";
    };

    ec11_left: ec11_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; /* D9 */
        b-gpios = <&gpio1 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; /* D10 */
        status = "okay";
    };
};
