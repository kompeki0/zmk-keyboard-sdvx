#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &out OUT_USB  &out OUT_BLE  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7
            >;
            sensor-bindings = <
                &inc_dec_kp A B
                &inc_dec_kp C D
            >;
        };
    };
};
